{
  "name": "cdxmonitor",
  "version": "0.6.0",
  "private": true,
  "type": "commonjs",
  "description": "CDXMonitor: local Codex Desktop stats monitor (read-only).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build",
    "typecheck:ui": "tsc -p tsconfig.webapp.json",
    "test": "npm run build && npm run typecheck:ui && node --test \"dist/tests/*.test.js\"",
    "snapshot": "node dist/src/cli.js",
    "serve": "node dist/src/main.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
